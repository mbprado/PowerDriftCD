diff --git a/src/mame/sega/segaybd.cpp b/src/mame/sega/segaybd.cpp
--- a/src/mame/sega/segaybd.cpp
+++ b/src/mame/sega/segaybd.cpp
@@ -581,0 +582,18 @@ uint32_t segaybd_state::screen_update(screen_device &screen, bitmap_ind16 &bitma
+	char const *const rows_dir = std::getenv("PDRIFT_LAYER_ROWS_DIR");
+	if (rows_dir && screen.frame_number() >= 966 && screen.frame_number() <= 980)
+	{
+		char path[1024];
+		std::snprintf(path, sizeof(path), "%s/layer-rows-%04d.csv", rows_dir, int(screen.frame_number()));
+		std::FILE *const out = std::fopen(path, "wb");
+		if (!out)
+			fatalerror("Cannot open layer rows: %s", path);
+		std::fprintf(out, "x,y,sprite,priority,final\n");
+		for (int y = 153; y <= 163; ++y)
+			for (int x = 0; x < 320; ++x)
+				std::fprintf(out, "%d,%d,%u,%u,%u\n", x, y,
+					unsigned(sprites.pix(y, x)),
+					unsigned(screen.priority().pix(y, x)),
+					unsigned(bitmap.pix(y, x)));
+		if (std::fclose(out))
+			fatalerror("Cannot close layer rows: %s", path);
+	}
