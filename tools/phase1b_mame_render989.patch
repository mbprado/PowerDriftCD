+					break;
+				visited[next] = 1;
+				if (next && first < 0)
+					first = next;
+				if (word0 & 0x5000)
+					++hidden;
+				++count;
+				next = space.read_word(0x180000 + next * 16 + 14) & 0xfff;
+			}
+			char path[1024];
+			std::snprintf(path, sizeof(path), "%s/ylist-%04llu.csv",
+				capture_dir, static_cast<unsigned long long>(frame));
+			std::FILE *const out = std::fopen(path, "wb");
+			if (!out)
+				fatalerror("Cannot open Y-list capture: %s", path);
+			std::fprintf(out, "frame,first_slot,count,hidden,next_slot\n%llu,%03X,%d,%d,%03X\n",
+				static_cast<unsigned long long>(frame), first, count, hidden, next);
+			if (std::fclose(out))
+				fatalerror("Cannot close Y-list capture: %s", path);
+		}
+	}
