+	if (char const *const capture_dir = std::getenv("PDRIFT_YBITMAP_DIR"))
+	{
+		uint64_t const frame = screen.frame_number();
+		if (frame >= 988 && frame <= 995)
+		{
+			int next = 0;
+			int first = -1;
+			int count = 0;
+			int hidden = 0;
+			uint8_t visited[0x1000] = {};
+			auto &space = m_subx->space(AS_PROGRAM);
+			while (!visited[next] && count < 0x1000)
+			{
+				uint16_t const word0 = space.read_word(0x180000 + next * 16);
